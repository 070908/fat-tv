<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay"
    android:padding="@dimen/tv_safe_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u97f3\u6e90\u8bbe\u7f6e"
            android:textSize="@dimen/text_display"
            android:textColor="@color/text_accent"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <RadioGroup
            android:id="@+id/rg_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_public"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u516c\u7f51\u97f3\u6e90"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u5c40\u57df\u7f51\u540e\u7aef"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:layout_marginStart="32dp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u5c40\u57df\u7f51\u540e\u7aef\u5730\u5740"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <EditText
            android:id="@+id/et_local_url"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="http://192.168.1.100:8090"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/text_caption"
            android:background="@drawable/input_focusable"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u7b2c\u4e09\u65b9\u97f3\u6e90\u63d2\u4ef6\u5730\u5740"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <EditText
            android:id="@+id/et_plugin_url"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="\u8f93\u5165\u97f3\u6e90\u63d2\u4ef6 URL"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/text_caption"
            android:background="@drawable/input_focusable"
            android:padding="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xl" />

<FrameLayout
            android:id="@+id/btn_save"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@drawable/card_home_focusable"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\u4fdd\u5b58\u8bbe\u7f6e"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_headline"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>

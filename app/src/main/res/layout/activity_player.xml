<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- 专辑封面模糊背景（通过代码动态设置） -->
    <ImageView
        android:id="@+id/bg_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25" />

    <!-- 暗渐变遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/tv_safe_margin">

        <!-- 顶部返回/歌曲信息区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_xl">

            <!-- 专辑封面：圆角 + 阴影 -->
            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/player_cover_size"
                android:layout_height="@dimen/player_cover_size"
                app:cardCornerRadius="@dimen/player_cover_corner"
                app:cardElevation="16dp"
                app:cardBackgroundColor="@android:color/transparent">
                <ImageView
                    android:id="@+id/iv_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_logo" />
            </androidx.cardview.widget.CardView>

            <!-- 歌曲名 -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="Song Title"
                android:textSize="@dimen/text_title"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- 艺人 / 专辑 -->
            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="Artist"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 播放进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:paddingHorizontal="@dimen/spacing_xxxl">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_secondary" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/player_progress_height"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:progressDrawable="@drawable/progress_gold"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 播放控制按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_xxl">

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="@dimen/player_control_btn_small"
                android:layout_height="@dimen/player_control_btn_small"
                android:src="@drawable/ic_prev"
                android:alpha="0.8"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/spacing_sm"
                android:background="@drawable/card_home_focusable" />

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="@dimen/player_control_btn_large"
                android:layout_height="@dimen/player_control_btn_large"
                android:src="@drawable/ic_play"
                android:layout_marginStart="@dimen/player_control_spacing"
                android:layout_marginEnd="@dimen/player_control_spacing"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/spacing_md"
                android:background="@drawable/card_home_focusable" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="@dimen/player_control_btn_small"
                android:layout_height="@dimen/player_control_btn_small"
                android:src="@drawable/ic_next"
                android:alpha="0.8"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/spacing_sm"
                android:background="@drawable/card_home_focusable" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

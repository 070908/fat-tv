<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <ImageView
        android:id="@+id/bg_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/tv_safe_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="360dp"
                android:layout_height="360dp"
                app:cardCornerRadius="@dimen/player_cover_corner"
                app:cardElevation="16dp"
                app:cardBackgroundColor="@android:color/transparent">
                <ImageView
                    android:id="@+id/iv_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_logo" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xxl"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Song Title"
                    android:textSize="@dimen/text_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Artist / Album"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_secondary"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <LinearLayout
                    android:id="@+id/tab_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tab_lyric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="歌词"
                        android:textSize="@dimen/text_headline"
                        android:textColor="@color/text_accent"
                        android:textStyle="bold"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:background="@drawable/tab_selector" />

                    <TextView
                        android:id="@+id/tab_album"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="专辑"
                        android:textSize="@dimen/text_headline"
                        android:textColor="@color/text_secondary"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:background="@drawable/tab_selector" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_lyric"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false"
                    android:paddingVertical="@dimen/spacing_sm" />

                <LinearLayout
                    android:id="@+id/album_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_album_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="专辑信息"
                        android:textSize="@dimen/text_headline"
                        android:textColor="@color/text_accent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_album_songs"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_md"
            android:paddingHorizontal="@dimen/spacing_xxxl">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_secondary" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/player_progress_height"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:progressDrawable="@drawable/progress_gold"
                android:max="100"
                android:progress="0" />

<TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 播放控制按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="@dimen/player_control_btn_small"
                android:layout_height="@dimen/player_control_btn_small"
                android:src="@drawable/ic_prev"
                android:alpha="0.8"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/spacing_sm"
                android:background="@drawable/card_home_focusable" />

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="@dimen/player_control_btn_large"
                android:layout_height="@dimen/player_control_btn_large"
                android:src="@drawable/ic_play"
                android:layout_marginStart="@dimen/player_control_spacing"
                android:layout_marginEnd="@dimen/player_control_spacing"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/spacing_md"
                android:background="@drawable/card_home_focusable" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="@dimen/player_control_btn_small"
                android:layout_height="@dimen/player_control_btn_small"
                android:src="@drawable/ic_next"
                android:alpha="0.8"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/spacing_sm"
                android:background="@drawable/card_home_focusable" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

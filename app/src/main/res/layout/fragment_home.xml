<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="4dp" android:paddingBottom="4dp" android:paddingStart="16dp" android:paddingEnd="16dp">

    <!-- ===== 第1行：最近播放 ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="最近播放"
        android:textSize="@dimen/text_headline"
        android:textColor="@color/text_accent"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:clipToPadding="false"
        android:layout_marginBottom="@dimen/spacing_sm" />

    <!-- 最近播放空态 -->
    <TextView
        android:id="@+id/tv_recent_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂无播放记录，请先搜索播放音乐"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:layout_gravity="center" />

    <!-- ===== 第2行：每日推荐 ===== -->
    <FrameLayout
        android:id="@+id/banner_daily"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:background="@drawable/card_home_focusable"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每日推荐"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_accent"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="根据您的偏好推荐音乐"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="@dimen/spacing_xs" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== 第3行：热门歌单 ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="热门歌单"
        android:textSize="@dimen/text_headline"
        android:textColor="@color/text_accent"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_playlists"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:clipToPadding="false"
        android:layout_marginBottom="@dimen/spacing_sm" />

    <!-- 热门歌单空态 -->
    <TextView
        android:id="@+id/tv_playlist_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂无推荐歌单"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:layout_gravity="center" />

    <!-- ===== 第4行：排行榜快捷入口 ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="排行榜"
        android:textSize="@dimen/text_headline"
        android:textColor="@color/text_accent"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_rank_quick"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- 排行榜空态 -->
    <TextView
        android:id="@+id/tv_rank_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="排行榜加载中..."
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:layout_gravity="center" />

</LinearLayout>
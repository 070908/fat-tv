<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- 海绵宝宝背景图（保留不变，alpha 0.35 透出黑底） -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        android:src="@drawable/bg_main" />

    <!-- 内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/tv_safe_margin"
        android:gravity="center_horizontal">

        <!-- 品牌名 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fat TV"
            android:textSize="@dimen/text_brand"
            android:textColor="@color/text_accent"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_xxxl" />

        <!-- 2x2 功能卡片网格 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 第一行：搜索 + 播放列表 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 搜索 -->
                <FrameLayout
                    android:id="@+id/btn_search"
                    android:layout_width="@dimen/home_card_width"
                    android:layout_height="@dimen/home_card_height"
                    android:background="@drawable/card_home_focusable"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusRight="@id/btn_playlist"
                    android:nextFocusDown="@id/btn_settings">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="@dimen/home_card_icon"
                            android:layout_height="@dimen/home_card_icon"
                            android:src="@drawable/ic_search"
                            android:layout_marginBottom="@dimen/spacing_sm" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_music"
                            android:textSize="@dimen/text_headline"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 播放列表 -->
                <FrameLayout
                    android:id="@+id/btn_playlist"
                    android:layout_width="@dimen/home_card_width"
                    android:layout_height="@dimen/home_card_height"
                    android:layout_marginStart="@dimen/home_card_spacing"
                    android:background="@drawable/card_home_focusable"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/btn_search"
                    android:nextFocusDown="@id/btn_source_switch">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="@dimen/home_card_icon"
                            android:layout_height="@dimen/home_card_icon"
                            android:src="@drawable/ic_playlist"
                            android:layout_marginBottom="@dimen/spacing_sm" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/playlist"
                            android:textSize="@dimen/text_headline"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 第二行：设置 + 切换音源 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/home_card_spacing">

                <!-- 设置 -->
                <FrameLayout
                    android:id="@+id/btn_settings"
                    android:layout_width="@dimen/home_card_width"
                    android:layout_height="@dimen/home_card_height"
                    android:background="@drawable/card_home_focusable"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusRight="@id/btn_source_switch"
                    android:nextFocusUp="@id/btn_search">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="@dimen/home_card_icon"
                            android:layout_height="@dimen/home_card_icon"
                            android:src="@drawable/ic_settings"
                            android:layout_marginBottom="@dimen/spacing_sm" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings"
                            android:textSize="@dimen/text_headline"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 切换音源 -->
                <FrameLayout
                    android:id="@+id/btn_source_switch"
                    android:layout_width="@dimen/home_card_width"
                    android:layout_height="@dimen/home_card_height"
                    android:layout_marginStart="@dimen/home_card_spacing"
                    android:background="@drawable/card_home_focusable"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusLeft="@id/btn_settings"
                    android:nextFocusUp="@id/btn_playlist">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="@dimen/home_card_icon"
                            android:layout_height="@dimen/home_card_icon"
                            android:src="@drawable/ic_source"
                            android:layout_marginBottom="@dimen/spacing_sm" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/switch_source"
                            android:textSize="@dimen/text_headline"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

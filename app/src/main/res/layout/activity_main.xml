<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- 全局背景：黑金海绵宝宝图（alpha 0.35，透出黑底） -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        android:src="@drawable/bg_main" />

    <!-- 全局暗色遮罩，确保文字可读 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_overlay" />

    <!-- 主内容：顶部导航栏 + Fragment 容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部导航栏（Tab 栏） -->
        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/tv_safe_margin"
            android:paddingEnd="@dimen/tv_safe_margin"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:background="@color/bg_surface">

            <!-- fat TV Logo/品牌 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fat TV"
                android:textSize="@dimen/text_brand"
                android:textColor="@color/text_accent"
                android:textStyle="bold"
                android:layout_marginEnd="48dp" />

            <!-- Tab 按钮：首页 -->
            <TextView
                android:id="@+id/tab_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_home"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector" />

            <!-- Tab 按钮：歌单 -->
            <TextView
                android:id="@+id/tab_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_playlist"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="16dp" />

            <!-- Tab 按钮：专辑 -->
            <TextView
                android:id="@+id/tab_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_album"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="16dp" />

            <!-- Tab 按钮：排行榜 -->
            <TextView
                android:id="@+id/tab_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_rank"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="16dp" />

            <!-- Tab 按钮：MV -->
            <TextView
                android:id="@+id/tab_mv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_mv"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="16dp" />

            <!-- Tab 按钮：本地音乐 -->
            <TextView
                android:id="@+id/tab_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_local"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- Fragment 内容容器 -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</FrameLayout>

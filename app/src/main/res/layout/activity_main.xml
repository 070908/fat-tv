<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- 全局背景：黑金海绵宝宝图（alpha 0.50，更透出黑底） -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.50"
        android:src="@drawable/bg_main" />

    <!-- 全局暗色遮罩，极轻，几乎不遮挡背景 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_overlay_light" />

    <!-- 主内容：顶部导航栏 + Fragment 容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部导航栏（Tab 栏）-->
        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/tv_safe_margin"
            android:paddingEnd="@dimen/tv_safe_margin"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:background="@color/bg_surface_light">

            <!-- 品牌：F A T（黑金色字符，替代头像） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F A T"
                android:textSize="@dimen/text_brand"
                android:textColor="@color/text_accent"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginEnd="32dp" />

            <!-- Tab 按钮：首页 -->
            <TextView
                android:id="@+id/tab_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_home"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector" />

            <!-- Tab 按钮：发现 -->
            <TextView
                android:id="@+id/tab_discover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_discover"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="8dp" />

            <!-- Tab 按钮：排行榜 -->
            <TextView
                android:id="@+id/tab_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_rank"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="8dp" />

            <!-- Tab 按钮：MV -->
            <TextView
                android:id="@+id/tab_mv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_mv"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="8dp" />

            <!-- Tab 按钮：我的 -->
            <TextView
                android:id="@+id/tab_mine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_mine"
                android:textSize="@dimen/text_headline"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="8dp" />

            <!-- 弹性 spacer 把搜索/设置推到右侧 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 搜索按钮 -->
            <ImageView
                android:id="@+id/btn_nav_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_search"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="8dp" />

            <!-- 设置按钮 -->
            <ImageView
                android:id="@+id/btn_nav_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_settings"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:background="@drawable/tab_selector"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Fragment 内容容器 -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================== 背景色 ==================== -->
    <!-- 主背景：纯黑，让海绵宝宝背景图充分展现 -->
    <color name="bg_primary">#000000</color>
    <!-- 卡片/面板背景：半透黑，隐约透出背景图 -->
    <color name="bg_surface">#CC000000</color>
    <color name="bg_surface_light">#E6000000</color>
    <!-- 输入框背景 -->
    <color name="bg_input">#66000000</color>
    <!-- 遮罩 -->
    <color name="bg_overlay">#99000000</color>
    <color name="bg_overlay_light">#66000000</color>

    <!-- ==================== 强调色（金色系，呼应海绵宝宝） ==================== -->
    <!-- 主品牌色：亮金黄 -->
    <color name="accent">#FFD700</color>
    <!-- 焦点态高亮：琥珀金 -->
    <color name="accent_focus">#FFA500</color>
    <!-- 激活/按下态：暗金 -->
    <color name="accent_pressed">#D4AF37</color>
    <!-- 强调色透明变体（用于外发光、边框渐变） -->
    <color name="accent_glow">#66FFD700</color>
    <color name="accent_border">#99FFD700</color>
    <!-- 进度条已完成部分 -->
    <color name="accent_progress">#FFD700</color>
    <!-- 进度条未完成部分 -->
    <color name="progress_track">#33FFD700</color>

    <!-- ==================== 文字色 ==================== -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B3FFFFFF</color>
    <color name="text_disabled">#66FFFFFF</color>
    <color name="text_hint">#80FFFFFF</color>
    <!-- 金色强调文字 -->
    <color name="text_accent">#FFD700</color>

    <!-- ==================== 焦点/状态色 ==================== -->
    <!-- 焦点边框 -->
    <color name="focus_border">#FFD700</color>
    <!-- 焦点外发光 -->
    <color name="focus_glow">#4DFFD700</color>
    <!-- 选中态背景 -->
    <color name="selected_bg">#33FFD700</color>
    <!-- 按下态背景 -->
    <color name="pressed_bg">#1AFFD700</color>

    <!-- ==================== 功能色 ==================== -->
    <color name="error">#FF5252</color>
    <color name="success">#69F0AE</color>
    <color name="warning">#FFD740</color>

    <!-- ==================== 分割线/边框 ==================== -->
    <color name="divider">#1AFFFFFF</color>
    <color name="divider_strong">#33FFFFFF</color>
    <color name="card_border">#1AFFFFFF</color>
    <color name="card_border_focused">#FFD700</color>
</resources>

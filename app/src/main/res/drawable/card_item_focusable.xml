<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点态 -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/selected_bg"/>
                    <corners android:radius="@dimen/song_item_corner"/>
                    <stroke android:width="@dimen/focus_border_width" android:color="@color/focus_border"/>
                </shape>
            </item>
            <item android:left="-3dp" android:right="-3dp" android:top="-3dp" android:bottom="-3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/song_item_corner"/>
                    <stroke android:width="3dp" android:color="@color/accent_glow"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 按下态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pressed_bg"/>
            <corners android:radius="@dimen/song_item_corner"/>
        </shape>
    </item>
    <!-- 普通态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface"/>
            <corners android:radius="@dimen/song_item_corner"/>
            <stroke android:width="1dp" android:color="@color/card_border"/>
        </shape>
    </item>
</selector>
